# Copy this file to .env.supabase in the repository root (gitignored).
# These variables are for LOCAL NODE SCRIPTS ONLY. No VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
DEMO_USERS_PASSWORD=REPLACE_WITH_A_UNIQUE_TEST_PASSWORD_12_PLUS_CHARS
